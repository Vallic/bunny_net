<?php

/**
 * @file
 * Update hooks for bunny.net.
 */

declare(strict_types=1);

/**
 * Installs Cache Purifier, which now decides the tags bunny.net sees.
 *
 * The tags.blocklist setting moves to Cache Purifier's outbound blocklist.
 */
function bunny_net_update_11001(): string {
  \Drupal::service('module_installer')->install(['cache_purifier']);

  $settings = \Drupal::configFactory()->getEditable('bunny_net.settings');
  $old = $settings->get('tags.blocklist');
  if (is_array($old)) {
    $purifier = \Drupal::configFactory()->getEditable('cache_purifier.settings');
    $blocklist = (array) $purifier->get('outbound.blocklist');
    $purifier->set('outbound.blocklist', array_values(array_unique([...$blocklist, ...$old])))->save();
  }
  $settings->clear('tags.blocklist')->save();

  return (string) t('Installed Cache Purifier and moved the tag blocklist to it.');
}

/**
 * Adds pull zone settings, kept in config and synced with Drush.
 */
function bunny_net_update_11002(): void {
  $settings = \Drupal::configFactory()->getEditable('bunny_net.settings');
  if ($settings->get('pull_zone_settings') === NULL) {
    $settings->set('pull_zone_settings', [])->save();
  }
}

/**
 * Adds caching settings, written to the pull zone with Drush.
 */
function bunny_net_update_11003(): void {
  $settings = \Drupal::configFactory()->getEditable('bunny_net.settings');
  if ($settings->get('caching') === NULL) {
    $settings->set('caching', [
      'enabled' => FALSE,
      'dynamic' => FALSE,
      'vary' => [],
      'vary_headers' => [],
      'vary_cookies' => [],
      'blocked_countries' => [],
      'skip_paths' => [],
      'session_cookies' => [],
      'browser_pages' => 0,
      'browser_files' => 0,
    ])->save();
  }
}

/**
 * Formerly added error_page settings, which 11005 removes again.
 */
function bunny_net_update_11004(): void {
}

/**
 * Removes the error_page settings: the page is a file at a fixed place now.
 *
 * See PullZoneSettings::ERROR_PAGE_FILE.
 */
function bunny_net_update_11005(): void {
  $settings = \Drupal::configFactory()->getEditable('bunny_net.settings');
  if ($settings->get('error_page') !== NULL) {
    $settings->clear('error_page')->save();
  }
}

/**
 * Adds sync_on_deploy, off.
 *
 * A deploy brings the pull zone in line only where an environment turns it on.
 */
function bunny_net_update_11006(): void {
  $settings = \Drupal::configFactory()->getEditable('bunny_net.settings');
  if ($settings->get('sync_on_deploy') === NULL) {
    $settings->set('sync_on_deploy', FALSE)->save();
  }
}
